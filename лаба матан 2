import numpy as np
import matplotlib.pyplot as plt
N = 50

def fx(t, N_terms=50):
    result = 3/4
    for n in range(1, N_terms+1):
        # Косинусный член
        cos_term = (((-1)n-1)/(n2 * np.pi**2)) * np.cos(n*np.pi*t/2)
        
        # Синусный член
        sin_term = (-1/(n*np.pi)) * np.sin(n*np.pi*t/2)
        
        result += cos_term + sin_term
    return result

# Создаем массив точек для построения графика
t = np.linspace(0, 12, 1000) 
y = np.array([fx(ti) for ti in t])

# Построение графика
plt.figure(figsize=(12, 6))
plt.plot(t, y, label='f(t)', linewidth=2)
plt.axhline(y=0, color='r', linestyle='--')
plt.title(f'График функции f(t) при S{N}')
plt.xlabel('t')
plt.ylabel('f(t)')
plt.grid(True, which='both', linestyle='--', alpha=0.5)
plt.legend()
plt.show()
